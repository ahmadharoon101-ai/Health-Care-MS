# Copy this file to .env and adjust as needed.
# All values are optional; sensible defaults are defined in backend/config.py

# Path to the medicine CSV file provided by the organization
MEDICINE_CSV_PATH=backend/data/medicine.csv

# Whisper model name: tiny | base | small | medium | large
WHISPER_MODEL_NAME=base

# Folder containing the pre-downloaded Whisper model weights (e.g. base.pt)
WHISPER_MODEL_PATH=backend/models/whisper

# cpu (recommended, no GPU required) or cuda
WHISPER_DEVICE=cpu

# Language code for transcription, or leave blank to auto-detect
WHISPER_LANGUAGE=en

# Fuzzy matching thresholds
MATCH_MIN_SCORE=60
MATCH_MAX_RESULTS=10

# Comma-separated list of allowed origins, or * for any
ALLOWED_ORIGINS=*

HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Added for the AI Laboratory Report Extraction & Patient Management System
# ---------------------------------------------------------------------------

# Database (SQLite by default — swap DATABASE_URL for Postgres/MySQL/etc. in production)
DB_PATH=backend/data/app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/clinic_db

# JWT signing secret — CHANGE THIS to a long random string in production.
# e.g. generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-change-me-in-.env
JWT_EXPIRE_MINUTES=480

# When true, self-registered Doctor/Lab Staff/Receptionist accounts are
# created as "pending" and need an Admin to Activate them before they can
# log in. Set to false to let new accounts log in immediately.
REQUIRE_ADMIN_APPROVAL=true

# Bootstrap Admin account, auto-created on first startup if no admin exists.
# CHANGE THE PASSWORD before deploying anywhere real.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@clinic.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Laboratory report uploads
UPLOAD_DIR=backend/uploads/lab_reports
MAX_UPLOAD_SIZE_MB=15
